{
  "name": "admitday",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "jest",
    "refresh:data": "ts-node --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' --transpile-only scripts/refresh-data.ts",
    "smoke": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/smoke.ts",
    "e2e": "playwright test",
    "eval:ask": "ts-node --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' --transpile-only evals/run-ask-eval.ts",
    "eval:retrieval": "ts-node --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' --transpile-only evals/run-retrieval-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@clerk/nextjs": "^6.39.6",
    "@langfuse/client": "5.14.0",
    "@langfuse/otel": "5.14.0",
    "@langfuse/tracing": "5.14.0",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@sentry/nextjs": "^10.47.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.3",
    "posthog-js": "^1.365.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.1",
    "dotenv": "^16.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "openai": "^4.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5"
  }
}
