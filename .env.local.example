# Copy this file to .env.local and fill in your values.

# --- AI providers ---
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# --- Database (schools) ---
# Postgres connection string. On Vercel this is injected automatically when you
# attach a Postgres store to the project. Locally, run `vercel env pull` to fetch it.
POSTGRES_URL=your_postgres_connection_string_here

# --- Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here

# --- LLM tracing (optional, logging only) ---
# Separate Langfuse project ("admitday-app") from the agent coordinator's
# (scripts/langfuse_trace.py uses LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY/
# LANGFUSE_HOST — deliberately different names here so the two never collide
# in a shared environment). Traces cost/latency/tokens/retrieval for product
# LLM calls (never question, answer, prompt, or chunk text). Set the
# project's data retention to 30 days in the Langfuse dashboard. Unset =
# tracing is a no-op; nothing else changes.
LANGFUSE_APP_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_APP_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_APP_HOST=https://cloud.langfuse.com
