# Copy this file to .env.local and fill in your values.

# --- AI providers ---
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# --- Database (schools) ---
# Postgres connection string. On Vercel this is injected automatically when you
# attach a Postgres store to the project. Locally, run `vercel env pull` to fetch it.
POSTGRES_URL=your_postgres_connection_string_here

# --- Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here

# --- Rate limiting (optional) ---
# Durable store for the LLM-route rate limiter (lib/rate-limit.ts), an
# Upstash Redis database's REST API credentials (from the Upstash console,
# or the Vercel "Upstash" marketplace integration). If unset, the limiter
# falls back to the original in-memory, per-instance counter — fine for
# local dev and tests, not a real global cap in production.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Hard global daily cap on LLM calls (/api/find/ask, /api/rationale),
# independent of the per-IP limit. Resets at UTC midnight. Defaults to
# 2000/day if unset — raise this without a deploy once real traffic
# patterns are known.
DAILY_LLM_CEILING=2000
