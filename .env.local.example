# Copy this file to .env.local and fill in your values.

# --- AI providers ---
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# --- Database (schools) ---
# Postgres connection string. On Vercel this is injected automatically when you
# attach a Postgres store to the project. Locally, run `vercel env pull` to fetch it.
POSTGRES_URL=your_postgres_connection_string_here

# --- Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here

# --- Auth (Clerk) ---
# From your Clerk instance's API Keys page. Required for sign up / log in /
# log out / password reset (issue #199).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# --- Rate limiting (optional) ---
# Durable store for the LLM-route rate limiter (lib/rate-limit.ts), an
# Upstash Redis database's REST API credentials (from the Upstash console,
# or the Vercel "Upstash" marketplace integration). If unset, the limiter
# falls back to the original in-memory, per-instance counter — fine for
# local dev and tests, not a real global cap in production.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Hard global daily cap on LLM calls (/api/find/ask, /api/rationale),
# independent of the per-IP limit. Resets at UTC midnight. Defaults to
# 2000/day if unset — raise this without a deploy once real traffic
# patterns are known.
DAILY_LLM_CEILING=2000

# --- LLM tracing (optional, logging only) ---
# Separate Langfuse project ("admitday-app") from the agent coordinator's
# (scripts/langfuse_trace.py uses LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY/
# LANGFUSE_HOST — deliberately different names here so the two never collide
# in a shared environment). Traces cost/latency/tokens/retrieval for product
# LLM calls (never question, answer, prompt, or chunk text). Set the
# project's data retention to 30 days in the Langfuse dashboard. Unset =
# tracing is a no-op; nothing else changes.
LANGFUSE_APP_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_APP_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_APP_HOST=https://cloud.langfuse.com
