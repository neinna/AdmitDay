# Copy this file to .env.local and fill in your values.

# --- AI providers ---
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# --- Database (schools) ---
# Postgres connection string. On Vercel this is injected automatically when you
# attach a Postgres store to the project. Locally, run `vercel env pull` to fetch it.
POSTGRES_URL=your_postgres_connection_string_here

# --- Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here

# --- Auth (Clerk) ---
# From your Clerk instance's API Keys page. Required for sign up / log in /
# log out / password reset (issue #199).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
